[Unit]
Description=Sliver C2 Server
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/.sliver-server
ExecStart=/usr/local/bin/sliver-server daemon
Restart=always
RestartSec=10

# Security measures
PrivateTmp=true
ProtectHome=false
NoNewPrivileges=true

# Hide process information
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target