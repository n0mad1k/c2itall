MYSQL_ROOT_PASS={{ lookup('password', '/dev/null length=32 chars=ascii_letters,digits') }}
MYSQL_DATABASE=hashtopolis
MYSQL_USER=hashtopolis
MYSQL_PASSWORD={{ lookup('password', '/dev/null length=32 chars=ascii_letters,digits') }}

HASHTOPOLIS_ADMIN_USER={{ hashtopolis_admin_user }}
HASHTOPOLIS_ADMIN_PASSWORD={{ lookup('password', '/dev/null length=24 chars=ascii_letters,digits') }}
HASHTOPOLIS_DB_HOST=db

# nginx serves the UI and the API from one origin, so nothing else is trusted.
HASHTOPOLIS_BACKEND_URL=https://{{ hashtopolis_host }}/api/v2
HASHTOPOLIS_FRONTEND_URLS=https://{{ hashtopolis_host }}
HASHTOPOLIS_FRONTEND_PORT=
HASHTOPOLIS_REFRESH_COOKIE_SAMESITE=
HASHTOPOLIS_REFRESH_COOKIE_SECURE=true
