[Unit]
Description=Pixel service
After=network.target

[Service]
User=tracker
Group=tracker
WorkingDirectory={{ tracker_home }}
ExecStart={{ tracker_home }}/venv/bin/python {{ tracker_home }}/simple_email_tracker.py
Restart=always
RestartSec=10

# Security settings
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ tracker_home }}/data
NoNewPrivileges=true

# Hide process information
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
