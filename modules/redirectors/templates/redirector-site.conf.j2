{% if edge_id is defined and edge_id %}
# Only requests the provider's edge stamped with this deployment's identifier
# are served; everything else is dropped without a response.
map $http_{{ edge_header | lower | replace('-', '_') }} $edge_ok {
    default 0;
    "{{ edge_id }}" 1;
}
{% endif %}

# HTTP to HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name {{ redirector_subdomain }}.{{ domain }};
{% if edge_id is defined and edge_id %}

    # The edge may terminate TLS itself and reach the origin over HTTP
    if ($edge_ok = 0) {
        return 444;
    }
    set_real_ip_from 0.0.0.0/0;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    include snippets/redirector-site.conf;
}
{% else %}
    
    # Redirect to HTTPS
    return 301 https://$host$request_uri;
}
{% endif %}

# Main HTTPS server
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ redirector_subdomain }}.{{ domain }};
    
    # SSL Configuration
    ssl_certificate {{ redirector_cert }};
    ssl_certificate_key {{ redirector_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305';
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    
    # Root directory
    root /var/www/html;
    index index.html;
    
{% if edge_id is defined and edge_id %}
    if ($edge_ok = 0) {
        return 444;
    }
    set_real_ip_from 0.0.0.0/0;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
{% endif %}
    include snippets/redirector-site.conf;
}

# Catch-all server block
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    
    ssl_certificate /etc/nginx/conf.d/selfsigned.crt;
    ssl_certificate_key /etc/nginx/conf.d/selfsigned.key;
    
    # Redirect unknown hosts to legitimate sites
    return 301 https://www.google.com;
    
    access_log off;
    error_log /dev/null crit;
}