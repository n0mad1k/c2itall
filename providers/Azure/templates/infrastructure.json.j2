{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups", "apiVersion": "2024-05-01",
      "name": {{ names.nsg | tojson }}, "location": {{ azure_location | tojson }}, "tags": {{ tags | tojson }},
      "properties": {"securityRules": [
        {"name": "operator-ssh", "properties": {"priority": 100, "direction": "Inbound", "access": "Allow", "protocol": "Tcp", "sourcePortRange": "*", "destinationPortRange": "22", "sourceAddressPrefix": {{ operator_ip | tojson }}, "destinationAddressPrefix": "*"}}{% for rule in azure_inbound_rules %},
        {"name": {{ rule.name | tojson }}, "properties": {"priority": {{ 109 + loop.index }}, "direction": "Inbound", "access": "Allow", "protocol": {{ rule.protocol | tojson }}, "sourcePortRange": "*", "destinationPortRange": {{ rule.port | tojson }}, "sourceAddressPrefix": {{ rule.source | tojson }}, "destinationAddressPrefix": "*"}}{% endfor %},
        {"name": "deny-other-inbound", "properties": {"priority": 400, "direction": "Inbound", "access": "Deny", "protocol": "*", "sourcePortRange": "*", "destinationPortRange": "*", "sourceAddressPrefix": "*", "destinationAddressPrefix": "*"}}
      ]}
    },
    {
      "type": "Microsoft.Network/virtualNetworks", "apiVersion": "2024-05-01",
      "name": {{ names.vnet | tojson }}, "location": {{ azure_location | tojson }}, "tags": {{ tags | tojson }},
      "properties": {"addressSpace": {"addressPrefixes": ["10.42.0.0/16"]}, "subnets": [{"name": "default", "properties": {"addressPrefix": "10.42.0.0/24"}}]}
    },
    {
      "type": "Microsoft.Network/publicIPAddresses", "apiVersion": "2024-05-01",
      "name": {{ names.public_ip | tojson }}, "location": {{ azure_location | tojson }}, "tags": {{ tags | tojson }},
      "sku": {"name": "Standard"}, "properties": {"publicIPAllocationMethod": "Static", "publicIPAddressVersion": "IPv4"}
    },
    {
      "type": "Microsoft.Network/networkInterfaces", "apiVersion": "2024-05-01",
      "name": {{ names.nic | tojson }}, "location": {{ azure_location | tojson }}, "tags": {{ tags | tojson }},
      "dependsOn": ["[resourceId('Microsoft.Network/virtualNetworks', '{{ names.vnet }}')]", "[resourceId('Microsoft.Network/networkSecurityGroups', '{{ names.nsg }}')]", "[resourceId('Microsoft.Network/publicIPAddresses', '{{ names.public_ip }}')]"],
      "properties": {
        "networkSecurityGroup": {"id": "[resourceId('Microsoft.Network/networkSecurityGroups', '{{ names.nsg }}')]"},
        "ipConfigurations": [{"name": "primary", "properties": {"privateIPAllocationMethod": "Dynamic", "subnet": {"id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', '{{ names.vnet }}', 'default')]"}, "publicIPAddress": {"id": "[resourceId('Microsoft.Network/publicIPAddresses', '{{ names.public_ip }}')]"}}}]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines", "apiVersion": "2024-11-01",
      "name": {{ names.vm | tojson }}, "location": {{ azure_location | tojson }}, "tags": {{ tags | tojson }},
      "dependsOn": ["[resourceId('Microsoft.Network/networkInterfaces', '{{ names.nic }}')]"],
      {% if image_plan %}"plan": {{ image_plan | tojson }},{% endif %}
      "properties": {
        "hardwareProfile": {"vmSize": {{ azure_vm_size | tojson }}},
        "storageProfile": {
          "imageReference": {{ image_reference | tojson }},
          "osDisk": {"name": {{ names.os_disk | tojson }}, "createOption": "FromImage", "diskSizeGB": {{ azure_os_disk_gb }}, "managedDisk": {"storageAccountType": "StandardSSD_LRS"}, "deleteOption": "Delete"}
        },
        "osProfile": {
          "computerName": {{ names.vm | tojson }}, "adminUsername": "azureuser",
          "linuxConfiguration": {"disablePasswordAuthentication": true, "provisionVMAgent": true, "ssh": {"publicKeys": [{"path": "/home/azureuser/.ssh/authorized_keys", "keyData": {{ ssh_public_key | tojson }}}]}}
        },
        "networkProfile": {"networkInterfaces": [{"id": "[resourceId('Microsoft.Network/networkInterfaces', '{{ names.nic }}')]", "properties": {"primary": true, "deleteOption": "Delete"}}]},
        "diagnosticsProfile": {"bootDiagnostics": {"enabled": true}}
      }
    }{% if azure_edge %},
    {
      "type": "Microsoft.Cdn/profiles", "apiVersion": "2024-02-01",
      "name": {{ names.edge | tojson }}, "location": "Global", "tags": {{ tags | tojson }},
      "sku": {"name": "Standard_AzureFrontDoor"},
      "properties": {"originResponseTimeoutSeconds": 60}
    },
    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints", "apiVersion": "2024-02-01",
      "name": {{ (names.edge ~ '/' ~ azure_edge.name) | tojson }}, "location": "Global",
      "dependsOn": ["[resourceId('Microsoft.Cdn/profiles', '{{ names.edge }}')]"],
      "properties": {"enabledState": "Enabled"}
    },
    {
      "type": "Microsoft.Cdn/profiles/originGroups", "apiVersion": "2024-02-01",
      "name": {{ (names.edge ~ '/origin') | tojson }},
      "dependsOn": ["[resourceId('Microsoft.Cdn/profiles', '{{ names.edge }}')]"],
      "properties": {
        "loadBalancingSettings": {"sampleSize": 4, "successfulSamplesRequired": 3, "additionalLatencyInMilliseconds": 50},
        "sessionAffinityState": "Disabled"
      }
    },
    {
      "type": "Microsoft.Cdn/profiles/originGroups/origins", "apiVersion": "2024-02-01",
      "name": {{ (names.edge ~ '/origin/vm') | tojson }},
      "dependsOn": ["[resourceId('Microsoft.Cdn/profiles/originGroups', '{{ names.edge }}', 'origin')]", "[resourceId('Microsoft.Network/publicIPAddresses', '{{ names.public_ip }}')]"],
      "properties": {
        "hostName": "[reference(resourceId('Microsoft.Network/publicIPAddresses', '{{ names.public_ip }}'), '2024-05-01').ipAddress]",
        "httpPort": 80, "httpsPort": 443, "originHostHeader": {{ azure_edge.host_header | tojson }},
        "priority": 1, "weight": 1000, "enabledState": "Enabled", "enforceCertificateNameCheck": true
      }
    },
    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints/routes", "apiVersion": "2024-02-01",
      "name": {{ (names.edge ~ '/' ~ azure_edge.name ~ '/default') | tojson }},
      "dependsOn": ["[resourceId('Microsoft.Cdn/profiles/afdEndpoints', '{{ names.edge }}', '{{ azure_edge.name }}')]", "[resourceId('Microsoft.Cdn/profiles/originGroups/origins', '{{ names.edge }}', 'origin', 'vm')]"],
      "properties": {
        "originGroup": {"id": "[resourceId('Microsoft.Cdn/profiles/originGroups', '{{ names.edge }}', 'origin')]"},
        "supportedProtocols": ["Http", "Https"], "patternsToMatch": ["/*"],
        "forwardingProtocol": {{ azure_edge.forwarding | tojson }},
        "linkToDefaultDomain": "Enabled", "httpsRedirect": "Disabled", "enabledState": "Enabled"
      }
    }{% endif %}
  ],
  "outputs": {
    "public_ip": {"type": "string", "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', '{{ names.public_ip }}'), '2024-05-01').ipAddress]"},
    "vm_id": {"type": "string", "value": "[resourceId('Microsoft.Compute/virtualMachines', '{{ names.vm }}')]"}{% if azure_edge %},
    "edge_id": {"type": "string", "value": "[reference(resourceId('Microsoft.Cdn/profiles', '{{ names.edge }}'), '2024-02-01').frontDoorId]"},
    "edge_hostname": {"type": "string", "value": "[reference(resourceId('Microsoft.Cdn/profiles/afdEndpoints', '{{ names.edge }}', '{{ azure_edge.name }}'), '2024-02-01').hostName]"}{% endif %}
  }
}
